# Neon Postgres — copy this value from Neon dashboard (Connection string)
DATABASE_URL=postgres://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Also supported as VITE_ prefix for client-side detection (optional, not secret in browser build):
VITE_DATABASE_URL=postgres://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# EmailJS (optional — for real emails)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxx
